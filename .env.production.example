# Production environment variables for the Frappe/ERPNext stack in Coolify.
# Set on the resource -> Environment Variables (Production). Do NOT commit real values.

# MariaDB root password — REQUIRED before the first deploy.
DB_PASSWORD=change-me-to-a-long-random-password

# Optional tuning (defaults are fine for most servers):
# GUNICORN_WORKERS=2
# GUNICORN_THREADS=4
# GUNICORN_TIMEOUT=120

# No build/token variables are needed: the compose file pulls official images
# and does not build anything. The custom app is installed later at runtime.
