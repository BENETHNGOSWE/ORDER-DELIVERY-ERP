# Production environment variables for the ERPNext/Delivery stack.
# In Coolify: Project > Environment Variables (set these on the resource).
# Do NOT commit the real values. This is a template only.

# MariaDB root password (generate a long random string)
MYSQL_ROOT_PASSWORD=change-me-to-a-long-random-password

# Set these AFTER the first deploy when you create the site
# (see DEPLOY-COOLIFY.md, step 6). SITE_NAME is your public domain.
SITE_NAME=delivery.kodatechnologies.co.tz
ADMIN_PASSWORD=set-a-strong-administrator-password
