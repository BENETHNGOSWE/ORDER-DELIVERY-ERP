# Production environment variables for the ERPNext/Delivery stack.
# In Coolify: open the resource -> Environment Variables and set these (Production).
# Do NOT commit real values. This is a template only.

# MariaDB root password (generate a long random string). REQUIRED.
DB_PASSWORD=change-me-to-a-long-random-password

# Optional: only if the GitHub repo is PRIVATE, set as a Coolify BUILD variable
# (Environment Variables -> Build Variable) so the image build can clone the app.
# GIT_TOKEN=ghp_xxx
